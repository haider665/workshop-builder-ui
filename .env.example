# Leave empty to use same-origin /api calls.
# Local Vite dev uses vite.config.ts proxy to https://cw.dotech.biz.
# Direct API origin. Leave empty only when using a same-origin reverse proxy.
VITE_API_BASE_URL=https://cw.dotech.biz
# Optional target for Vite's /api development proxy when VITE_API_BASE_URL is empty.
VITE_DEV_API_PROXY_TARGET=https://cw.dotech.biz
